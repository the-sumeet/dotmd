---
import { Image } from "astro:assets";
import screenshot from "../assets/screenshot.png";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="mx-auto flex max-w-6xl flex-col items-center gap-14 px-4 pt-20 pb-16 text-center sm:px-6">
  <div class="flex max-w-3xl flex-col items-center gap-6">
    <img src={`${base}/appicon.png`} alt="" width="96" height="96" class="size-24 rounded-xl" />
    <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">dotmd</h1>
    <p class="text-xl text-foreground/70">A Markdown notes app that keeps your notes as plain files on your computer.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="#download" class="rounded-lg bg-primary px-6 py-3 font-semibold text-primary-foreground hover:opacity-90">Download</a>
      <a href="https://github.com/the-sumeet/dotmd" class="rounded-lg border border-border px-6 py-3 font-semibold hover:bg-accent">View on GitHub</a>
    </div>
  </div>
  <Image
    src={screenshot}
    alt="dotmd showing a Markdown note with the file explorer open beside it"
    widths={[640, 1024, 1536, 2048]}
    sizes="(min-width: 72rem) 70rem, 100vw"
    loading="eager"
    class="w-full rounded-lg border border-border shadow-2xl"
  />
</header>
