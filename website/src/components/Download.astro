---
const releases = "https://github.com/the-sumeet/dotmd/releases/latest";
const platforms = [
  { name: "macOS", detail: "Universal .dmg" },
  { name: "Windows", detail: "Installer for amd64 and arm64" },
  { name: "Linux", detail: ".deb, .rpm or .AppImage" },
];
---

<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6" id="download">
  <h2 class="mb-3 text-3xl font-bold">Download</h2>
  <p class="mb-8 text-foreground/70">Free builds for every major desktop platform.</p>
  <ul class="mb-8 grid gap-4 sm:grid-cols-3">
    {
      platforms.map((p) => (
        <li class="rounded-lg border border-border bg-card p-5">
          <p class="font-semibold">{p.name}</p>
          <p class="text-sm text-foreground/70">{p.detail}</p>
        </li>
      ))
    }
  </ul>
  <a href={releases} class="inline-block rounded-lg bg-primary px-6 py-3 font-semibold text-primary-foreground hover:opacity-90">Get the latest release</a>
</section>
